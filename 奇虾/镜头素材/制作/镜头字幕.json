  "captions": [
    { "start": 0.06, "end": 3.52, "anchor": [0.56, 0.225], "lines": ["五亿年前的奇虾，", "怎么把猎物送进嘴里？"] },
    { "start": 3.72, "end": 6.72, "anchor": [0.09, 0.102], "lines": ["两条前附肢之间，", "圆形的嘴正一张一合。"] },
    { "start": 6.94, "end": 11.50, "anchor": [0.56, 0.780], "lines": ["带刺的附肢一卷，", "就把猎物送到了嘴边。"] },
    { "start": 11.75, "end": 14.88, "anchor": [0.633, 0.134], "lines": ["单看这条弯曲的附肢，", "像不像一只虾？"] },
    { "start": 15.03, "end": 18.13, "anchor": [0.633, 0.134], "lines": ["1892 年，它的化石", "就被当成了虾身。"] }
  ]
}
